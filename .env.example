# Copy to .env and adjust. The app must start with no cloud keys set.

VERITAS_ENV=development
VERITAS_DATA_DIR=./data
VERITAS_DATABASE_URL=sqlite:///./data/veritas.sqlite3
VERITAS_MAX_UPLOAD_MB=50

# Local inference (default)
VERITAS_LLM_PROVIDER=ollama
VERITAS_OLLAMA_HOST=http://localhost:11434
# qwen3:4b runs in "thinking" mode by default. The provider must call it with
# think=False, or switch to the non-thinking build: qwen3:4b-instruct-2507
VERITAS_OLLAMA_MODEL=qwen3:4b
VERITAS_OLLAMA_NUM_CTX=8192
VERITAS_LLM_TEMPERATURE=0

# Optional cloud inference (disabled by default; never required)
VERITAS_CLOUD_ENABLED=false
VERITAS_CLOUD_PROVIDER=
VERITAS_CLOUD_MODEL=
VERITAS_CLOUD_API_KEY=

# Embeddings (Milestone 3)
VERITAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
