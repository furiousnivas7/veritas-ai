# Copy to .env and adjust. The app must start with no cloud keys set.

VERITAS_ENV=development
VERITAS_DATA_DIR=./data
VERITAS_DATABASE_URL=sqlite:///./data/veritas.sqlite3
VERITAS_MAX_UPLOAD_MB=50

# Local inference (default)
VERITAS_LLM_PROVIDER=ollama
VERITAS_OLLAMA_HOST=http://localhost:11434
VERITAS_OLLAMA_MODEL=qwen3:4b
VERITAS_OLLAMA_NUM_CTX=8192
# off = send think=false (default); on; auto = omit the parameter
VERITAS_OLLAMA_THINK=off
# schema = JSON-schema constrained decoding; json = JSON mode + schema in prompt.
# qwen3:4b-instruct-2507-q4_K_M hangs with "schema" on Ollama 0.40.18: use "json".
VERITAS_OLLAMA_FORMAT=schema
VERITAS_OLLAMA_TIMEOUT_S=180
VERITAS_LLM_SEED=42
VERITAS_EXTRACTION_MAX_RETRIES=2
VERITAS_EXTRACTION_BATCH_CHARS=1800
# document_scoped (default): exact-name merges only within a document; cross-document
# matches go to review. global_name_match: name-only merging (E5 baseline only).
VERITAS_ENTITY_RESOLUTION_POLICY=document_scoped
# detect (default): content-based table-header detection (decisions are audited in
# run stats). never: every table row is data; no first row is ever withheld.
VERITAS_TABLE_HEADER_POLICY=detect
# Deterministic currency/period enrichment from the cited evidence (on|off).
VERITAS_METADATA_ENRICHMENT=on
# Explicit resolutions for ambiguous currency symbols ($, Rs., rupees, dollars,
# pounds, ¥). Empty = unresolved. Example: {"Rs": "LKR"}
VERITAS_CURRENCY_SYMBOL_DEFAULTS={}
# Extraction prompt version (1.0.0 kept for reproducing earlier runs).
VERITAS_EXTRACTION_PROMPT_VERSION=1.1.0
VERITAS_LLM_TEMPERATURE=0

# Optional cloud inference (disabled by default; never required)
VERITAS_CLOUD_ENABLED=false
VERITAS_CLOUD_PROVIDER=
VERITAS_CLOUD_MODEL=
VERITAS_CLOUD_API_KEY=

# Embeddings (Milestone 3)
VERITAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
